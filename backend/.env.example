# Server Port
PORT=3001

# Trino Distributed Query Engine
TRINO_URL=http://localhost:8080
TRINO_USER=finance-app
TRINO_CATALOG=iceberg
TRINO_SCHEMA=banking

# MinIO / S3 Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=finance-lake
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1

# Apache Iceberg REST Catalog
ICEBERG_REST_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://finance-lake/warehouse/
ICEBERG_CATALOG_NAME=finance
DEFAULT_NAMESPACE=banking

# HMAC Secret
CURSOR_SECRET=your_32_character_cursor_secret_here

